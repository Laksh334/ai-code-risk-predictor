# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=change-me
CORS_ORIGINS=http://localhost:5173
DASHBOARD_URL=http://localhost:5173
# 0 = skip the ~1 GB emotion model (for machines/servers with little RAM)
RISK_USE_HF=1

# GitHub App (optional, see README "GitHub App")
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# PEM text with newlines written as \n
GITHUB_PRIVATE_KEY=
GITHUB_TOKEN=
